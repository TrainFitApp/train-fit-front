// Las reglas están en ../../.eslintrc.base.json, compartidas con las otras dos
// apps y con packages/. Aquí solo va lo propio de esta app: qué tsconfig da
// los tipos a las reglas que los necesitan.
{
  "root": true,
  "ignorePatterns": ["projects/**/*", "www/**/*", "dist/**/*", "out-tsc/**/*"],
  "extends": ["../../.eslintrc.base.json"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["tsconfig.json"]
      }
    }
  ]
}
