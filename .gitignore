# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.angular
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Certificate files
*.p12
*.cer
*.csr
*.key
*.pem
*_base64.txt

bash.exe.stackdump

# Ojo: la regla suelta "build.yml" (sin barra) casa con CUALQUIER fichero de ese
# nombre a cualquier profundidad, incluido .github/workflows/build.yml — por eso
# los workflows de deploy nunca llegaron a subirse al repositorio. Se ancla a la
# raíz para que solo afecte al build.yml de Ionic Appflow.
/build.yml
