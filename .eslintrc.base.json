// Reglas comunes a las tres apps y a packages/. Cada .eslintrc.json las
// extiende y solo añade su parserOptions (qué tsconfig da los tipos).
//
// ERROR vs WARN — la política, que importa más que la lista:
//
//   · error = rompe el lint, y por tanto el build a producción (ver el script
//     `verify` en package.json). Son las reglas que HOY se cumplen en todo el
//     monorepo: dejarlas en error no cuesta nada y evita que entre la primera
//     infracción.
//   · warn = se incumple ya, y mucho. Sale en `npm run lint:report` como
//     deuda pendiente, pero no bloquea: con 23.000 infracciones heredadas,
//     ponerlas en error sería tener el build roto para siempre.
//
// La regla para mover algo de warn a error es simple: deja esa regla a cero y
// súbela. NO al contrario — bajar una regla a warn para que pase el build es
// exactamente lo que hay que evitar.
//
// Recuento del 2026-10-01 (packages/ + las tres apps), por si sirve para
// priorizar: typedef 9301, explicit-function-return-type 4005,
// no-unsafe-assignment 2354, no-unsafe-member-access 1513, prefer-readonly 993,
// no-unsafe-return 815, no-floating-promises 709,
// explicit-member-accessibility 696, no-explicit-any 668,
// no-unsafe-argument 587, no-unsafe-call 400, member-ordering 333,
// explicit-module-boundary-types 252, array-type 141,
// no-unnecessary-type-assertion 122, no-unused-vars 79, unbound-method 71,
// no-misused-promises 44, y 18 reglas más con menos de 20 cada una.
//
// Esas 18 últimas suman ~110 infracciones en unos 15 ficheros: son las
// candidatas realistas a volver a error en una sentada.
{
  "overrides": [
    {
      "files": ["*.ts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "plugins": ["@typescript-eslint"],
      "extends": [
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates",
        "plugin:@typescript-eslint/recommended",
        "plugin:@typescript-eslint/recommended-requiring-type-checking"
      ],
      "rules": {
        // --- ERROR: limpias hoy, que sigan así -----------------------------
        // Convenciones de Angular (sufijo de clase, prefijo de selector).
        "@angular-eslint/component-class-suffix": ["error", { "suffixes": ["Page", "Component"] }],
        "@angular-eslint/component-selector": [
          "error",
          { "type": "element", "prefix": "app", "style": "kebab-case" }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          { "type": "attribute", "prefix": "app", "style": "camelCase" }
        ],
        "@typescript-eslint/prefer-enum-initializers": "error",
        // El tipo redundante (`const x: number = 5`) se tolera a propósito:
        // choca de frente con typedef, que lo exige.
        "@typescript-eslint/no-inferrable-types": "off",

        // Las dos que vigilan eval() y los enum con valores repetidos se
        // quedan en ERROR. Los dos únicos sitios que las incumplían están
        // acotados con un eslint-disable en su línea y explicados ahí
        // (shared-ui/constants/calculators.ts y shared-ui/models/macros-data.ts),
        // justo para que cualquier caso NUEVO rompa el lint.
        "@typescript-eslint/no-implied-eval": "error",
        "@typescript-eslint/no-duplicate-enum-values": "error",

        // --- WARN: deuda heredada masiva -----------------------------------
        // Tipado explícito. Son las dos más ruidosas con diferencia (13.000
        // entre las dos) y las que menos riesgo esconden.
        "@typescript-eslint/explicit-function-return-type": [
          "warn",
          {
            "allowExpressions": false,
            "allowTypedFunctionExpressions": false,
            "allowHigherOrderFunctions": false,
            "allowDirectConstAssertionInArrowFunctions": false,
            "allowConciseArrowFunctionExpressionsStartingWithVoid": false
          }
        ],
        "@typescript-eslint/typedef": [
          "warn",
          {
            "arrayDestructuring": true,
            "arrowParameter": true,
            "memberVariableDeclaration": true,
            "objectDestructuring": true,
            "parameter": true,
            "propertyDeclaration": true,
            "variableDeclarationIgnoreFunction": false,
            "variableDeclaration": true
          }
        ],
        "@typescript-eslint/explicit-member-accessibility": [
          "warn",
          { "accessibility": "explicit", "overrides": { "constructors": "no-public" } }
        ],
        "@typescript-eslint/explicit-module-boundary-types": "warn",
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/prefer-readonly": "warn",
        "@typescript-eslint/member-ordering": [
          "warn",
          { "default": ["signature", "field", "constructor", "method"] }
        ],
        "@typescript-eslint/array-type": ["warn", { "default": "array-simple" }],
        "@typescript-eslint/consistent-type-definitions": ["warn", "interface"],

        // El grupo `any` implícito: lo que viene del backend sin tipar. Son
        // las que más valor tendrían de las ruidosas, porque cada una esconde
        // un sitio donde el tipo no se comprueba.
        "@typescript-eslint/no-unsafe-assignment": "warn",
        "@typescript-eslint/no-unsafe-member-access": "warn",
        "@typescript-eslint/no-unsafe-return": "warn",
        "@typescript-eslint/no-unsafe-argument": "warn",
        "@typescript-eslint/no-unsafe-call": "warn",
        "@typescript-eslint/no-unsafe-enum-comparison": "warn",
        "@typescript-eslint/restrict-template-expressions": "warn",
        "@typescript-eslint/no-base-to-string": "warn",
        "@typescript-eslint/no-redundant-type-constituents": "warn",
        "@typescript-eslint/no-unnecessary-type-assertion": "warn",

        // Promesas sin await ni catch. 709 + 44: de las más propensas a
        // esconder un error que se traga en silencio.
        "@typescript-eslint/no-floating-promises": "warn",
        "@typescript-eslint/no-misused-promises": "warn",
        "@typescript-eslint/require-await": "warn",
        "@typescript-eslint/unbound-method": "warn",

        // Código muerto. 79 casos: de las primeras que convendría limpiar.
        "@typescript-eslint/no-unused-vars": [
          "warn",
          { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
        ],

        // --- WARN: casi limpias, candidatas a volver a error ---------------
        // ~26 infracciones en unos 15 ficheros, todas de una línea.
        "@typescript-eslint/prefer-as-const": "warn",
        "@typescript-eslint/no-array-constructor": "warn",
        "@typescript-eslint/no-useless-constructor": "warn",
        "@typescript-eslint/no-unsafe-declaration-merging": "warn",
        "prefer-const": "warn",
        "@angular-eslint/no-empty-lifecycle-method": "warn",
        "@angular-eslint/use-lifecycle-interface": "warn",
        "@angular-eslint/no-output-native": "warn",
        "@angular-eslint/no-output-on-prefix": "warn",
        "@angular-eslint/no-input-rename": "warn"
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {
        // 3 casos de `!=` en plantillas del entrenador.
        "@angular-eslint/template/eqeqeq": "warn"
      }
    }
  ]
}
