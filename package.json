{
  "name": "train-fit-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "serve": "npm run start --workspace @trainfit/train-fit-front",
    "serve:m": "npm run start --workspace @trainfit/train-fit-management",
    "build:i": "npm run build:i --workspace @trainfit/train-fit-front",
    "build:a": "npm run build:a --workspace @trainfit/train-fit-front",
    "build:i:m": "npm run build:i --workspace @trainfit/train-fit-management",
    "build:a:m": "npm run build:a --workspace @trainfit/train-fit-management",
    "lint": "npm run lint --workspace @trainfit/train-fit-front",
    "lint:m": "npm run lint --workspace @trainfit/train-fit-management"
  }
}
